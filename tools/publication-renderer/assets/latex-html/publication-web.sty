\definecolor{publicationaccent}{HTML}{3F21B6}
\hypersetup{
  colorlinks=true,
  linkcolor=publicationaccent,
  citecolor=publicationaccent,
  urlcolor=publicationaccent
}

\setcounter{secnumdepth}{-1}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\providecommand{\real}[1]{#1}

\newcommand{\publicationtitle}[1]{\def\PublicationTitleText{#1}}
\newcommand{\publicationauthors}[1]{\def\PublicationAuthorsText{#1}}
\newcommand{\publicationaffiliations}[1]{\def\PublicationAffiliationsText{#1}}
\newcommand{\publicationdate}[1]{\def\PublicationDateText{#1}}
\publicationdate{}

\newenvironment{publicationhead}{%
  \ifdefined\HCode
    \ifvmode\IgnorePar\fi\EndP
    \HCode{<header class="publication-head">}%
  \else
    \par\noindent\rule{\linewidth}{1pt}\par\vspace{1.1em}%
  \fi
}{%
  \ifdefined\HCode
    \ifvmode\IgnorePar\fi\EndP
    \HCode{</header>}\ShowPar
  \fi
}

\newcommand{\makepublicationtitle}{%
  \ifdefined\HCode
    \ifvmode\IgnorePar\fi\EndP
    \HCode{<div class="publication-title-block"><h1 class="publication-title">}%
    \PublicationTitleText
    \HCode{</h1><p class="publication-authors">}%
    \PublicationAuthorsText
    \HCode{</p><p class="publication-affiliations">}%
    \PublicationAffiliationsText
    \HCode{</p>}%
    \ifx\PublicationDateText\empty\else
      \HCode{<p class="publication-date">}\PublicationDateText\HCode{</p>}%
    \fi
    \HCode{</div>}\ShowPar
  \else
    {\LARGE\bfseries\PublicationTitleText\par}
    \vspace{0.8em}
    {\normalsize\bfseries\PublicationAuthorsText\par}
    {\small\PublicationAffiliationsText\par}
    \ifx\PublicationDateText\empty\else
      {\small\PublicationDateText\par}%
    \fi
    \vspace{0.5em}\noindent\rule{\linewidth}{1pt}\par
  \fi
}

\newcommand{\publicationabstract}[1]{%
  \ifdefined\HCode
    \ifvmode\IgnorePar\fi\EndP
    \HCode{<section class="publication-abstract"><h2 class="publication-abstract-heading">Abstract</h2><div class="publication-abstract-body">}%
    #1%
    \HCode{</div></section>}\ShowPar
  \else
    \begin{center}\textbf{Abstract}\end{center}
    {\small #1\par}%
  \fi
}

\newcommand{\publicationactions}[1]{%
  \ifdefined\HCode
    \ifvmode\IgnorePar\fi\EndP
    \HCode{<nav class="publication-actions" aria-label="Project resources">}%
    #1%
    \HCode{</nav>}\ShowPar
  \else
    \par\medskip\noindent #1\par
  \fi
}

\newcommand{\publicationaction}[2]{%
  \ifdefined\HCode
    \HCode{<a class="publication-action" href="#1">}#2\HCode{</a>}%
  \else
    \href{#1}{\textbf{#2}}\quad
  \fi
}

% Links line (same setters as axym-publication.sty, so a paper preamble can be
% reused, plus arXiv mirrors and software resources). \makepublicationlinks
% prints one centered row of icon-and-label links; empty entries are omitted.
% In HTML each entry is <a class="publication-link publication-link-KIND">,
% and the site draws the icon for KIND.
\newcommand{\publicationarxiv}[1]{\def\PublicationArxiv{#1}}
\newcommand{\publicationhfpapers}[1]{\def\PublicationHFPapers{#1}}
\newcommand{\publicationmodels}[2][Models]{%
  \def\PublicationModelsLabel{#1}\def\PublicationModels{#2}}
\newcommand{\publicationdata}[2][Data]{%
  \def\PublicationDataLabel{#1}\def\PublicationData{#2}}
\newcommand{\publicationcode}[2][Code]{%
  \def\PublicationCodeLabel{#1}\def\PublicationCode{#2}}
\newcommand{\publicationdocs}[2][Documentation]{%
  \def\PublicationDocsLabel{#1}\def\PublicationDocs{#2}}
\newcommand{\publicationpackage}[2][Package]{%
  \def\PublicationPackageLabel{#1}\def\PublicationPackage{#2}}
\newcommand{\publicationdemo}[2][Demo]{%
  \def\PublicationDemoLabel{#1}\def\PublicationDemo{#2}}
\newcommand{\publicationprojectpage}[2][Project page]{%
  \def\PublicationProjectPageLabel{#1}\def\PublicationProjectPage{#2}}
\newcommand{\publicationcorrespondence}[1]{\def\PublicationCorrespondence{#1}}
\publicationarxiv{}
\publicationhfpapers{}
\publicationmodels{}
\publicationdata{}
\publicationcode{}
\publicationdocs{}
\publicationpackage{}
\publicationdemo{}
\publicationprojectpage{}
\publicationcorrespondence{}

\newcommand{\publicationweb@linkentry}[3]{% kind, url, label
  \ifdefined\HCode
    \HCode{<a class="publication-link publication-link-#1" href="#2">}#3\HCode{</a>}%
  \else
    \mbox{\href{#2}{#3}}\hspace{1.5em plus 0.5em}%
  \fi}
\newcommand{\publicationweb@hostentry}[5]{% url macro, label, host, kind, fallback
  \edef\publicationweb@test{\noexpand\in@{\detokenize{#3}}%
    {\expandafter\detokenize\expandafter{#1}}}%
  \publicationweb@test
  \ifin@\def\publicationweb@kind{#4}\else\def\publicationweb@kind{#5}\fi
  \publicationweb@linkentry{\publicationweb@kind}{#1}{#2}}
\newcommand{\publicationweb@ifset}[2]{\ifx#1\empty\else#2\fi}
\newcommand{\makepublicationlinks}{%
  \ifdefined\HCode
    \ifvmode\IgnorePar\fi\EndP
    \HCode{<nav class="publication-links" aria-label="Links">}%
  \else
    \par\medskip{\centering
  \fi
  \publicationweb@ifset\PublicationArxiv{%
    \publicationweb@linkentry{arxiv}{https://arxiv.org/abs/\PublicationArxiv}{arXiv}%
    \publicationweb@linkentry{alphaxiv}{https://www.alphaxiv.org/abs/\PublicationArxiv}{alphaXiv}}%
  \publicationweb@ifset\PublicationHFPapers{%
    \publicationweb@linkentry{hfpapers}{https://huggingface.co/papers/\PublicationHFPapers}{Hugging Face Papers}}%
  \publicationweb@ifset\PublicationCode{%
    \publicationweb@hostentry{\PublicationCode}{\PublicationCodeLabel}{github.com}{github}{code}}%
  \publicationweb@ifset\PublicationModels{%
    \publicationweb@hostentry{\PublicationModels}{\PublicationModelsLabel}{huggingface.co}{huggingface}{data}}%
  \publicationweb@ifset\PublicationData{%
    \publicationweb@hostentry{\PublicationData}{\PublicationDataLabel}{huggingface.co}{huggingface}{data}}%
  \publicationweb@ifset\PublicationDocs{%
    \publicationweb@linkentry{docs}{\PublicationDocs}{\PublicationDocsLabel}}%
  \publicationweb@ifset\PublicationPackage{%
    \publicationweb@linkentry{package}{\PublicationPackage}{\PublicationPackageLabel}}%
  \publicationweb@ifset\PublicationDemo{%
    \publicationweb@linkentry{demo}{\PublicationDemo}{\PublicationDemoLabel}}%
  \publicationweb@ifset\PublicationProjectPage{%
    \publicationweb@linkentry{home}{\PublicationProjectPage}{\PublicationProjectPageLabel}}%
  \publicationweb@ifset\PublicationCorrespondence{%
    \publicationweb@linkentry{email}{mailto:\PublicationCorrespondence}{\PublicationCorrespondence}}%
  \ifdefined\HCode
    \HCode{</nav>}\ShowPar
  \else
    \par}\medskip
  \fi
}

% Abstract split into its parts, each a labeled paragraph:
%   \begin{publicationsummary}
%     \publicationsummarypart{Problem}{...}
%   \end{publicationsummary}
\newenvironment{publicationsummary}{%
  \ifdefined\HCode
    \ifvmode\IgnorePar\fi\EndP
    \HCode{<dl class="publication-summary">}%
  \else
    \par\medskip
  \fi
}{%
  \ifdefined\HCode
    \HCode{</dl>}\ShowPar
  \else
    \par\medskip
  \fi
}
\newcommand{\publicationsummarypart}[2]{%
  \ifdefined\HCode
    \HCode{<div class="publication-summary-part"><dt class="publication-summary-label">}#1%
    \HCode{</dt><dd class="publication-summary-text">}#2\HCode{</dd></div>}%
  \else
    \par\noindent\textsc{#1}\quad #2\par\smallskip
  \fi
}

% Copyable citation block around a verbatim BibTeX entry.
\newenvironment{publicationcitation}{%
  \ifdefined\HCode
    \ifvmode\IgnorePar\fi\EndP
    \HCode{<section class="publication-citation" id="citation"><h2 class="publication-citation-heading">Citation</h2>}%
  \else
    \section*{Citation}%
  \fi
}{%
  \ifdefined\HCode
    \ifvmode\IgnorePar\fi\EndP
    \HCode{</section>}\ShowPar
  \fi
}

\newcommand{\publicationfigure}[5][\linewidth]{%
  \refstepcounter{figure}%
  \ifdefined\HCode
    \ifvmode\IgnorePar\fi\EndP
    \HCode{<figure class="publication-figure"><img src="#3" alt="#4" loading="lazy" decoding="async" /><figcaption>}%
    \textbf{Figure \thefigure.} #5%
    \HCode{</figcaption></figure>}\ShowPar
  \else
    \begin{figure}[htbp]
      \centering
      \includegraphics[width=#1]{#2}
      \caption{#5}
    \end{figure}
  \fi
}

\newcommand{\publicationbadge}[3]{%
  \ifdefined\HCode
    \HCode{<a class="publication-badge" href="#1"><img src="#2" alt="#3" /></a>}%
  \else
    \href{#1}{#3}%
  \fi
}

\newcommand{\publicationdivider}{%
  \ifdefined\HCode
    \ifvmode\IgnorePar\fi\EndP
    \HCode{<hr class="publication-divider" />}\ShowPar
  \else
    \begin{center}\rule{0.5\linewidth}{0.5pt}\end{center}%
  \fi
}
